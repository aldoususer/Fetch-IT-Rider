{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["sin1"],
  "buildCommand": "prisma generate && next build",
  "github": {
    "silent": true
  },
  "functions": {
    "src/app/api/auth/seed/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/bookings/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/**/*.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/maintenance/tracking",
      "schedule": "0 2 * * *"
    }
  ]
}
