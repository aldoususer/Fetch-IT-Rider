// Canonical Fetch schema: maintained in fetch-customer/prisma.
// Run node scripts/sync-shared.cjs after changes; only this app deploys migrations.
// All apps share the same Neon PostgreSQL database.

enum UserRole {
  CUSTOMER
  RIDER
  ADMIN
  SUPPORT
  FINANCE
  SAFETY
  SUPPORT_SUPERVISOR
  SUPERADMIN
}

enum AuthProvider {
  FIREBASE
  PASSWORD
}

enum BookingType {
  DELIVERY
  RIDE
}

enum CustomerNotificationCategory {
  DELIVERY
  RIDE
  SUPPORT
}

enum BookingStatus {
  PENDING
  MATCHED
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum VehicleClass {
  MOTORCYCLE
  TRICYCLE
  SEDAN
  CLOSED_VAN
  FLATBED
  REFRIGERATED
}

enum TrackingSource {
  LEGACY
  NATIVE
}

enum ProofType {
  SIGNATURE
  OTP
  PHOTO
}

enum SupportCategory {
  BOOKING
  FARE
  RIDER
  LOST_ITEM
  OTHER
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum BookingEventAction {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  CANCELLED
  REASSIGNED
}

enum PaymentMethod {
  CASH
  DEMO_GCASH
  DEMO_MAYA
  DEMO_BANK
}

enum DemoCheckoutStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
  FAILED
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String
  phone             String?
  role              UserRole       @default(CUSTOMER)
  isBanned          Boolean        @default(false)
  banReason         String?
  bannedAt          DateTime?
  authInvalidBefore DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  ownerIdentity     OwnerIdentity?

  authIdentities   AuthIdentity[]
  riderProfile     RiderProfile?
  riderPresence    RiderPresence?
  riderApplication RiderApplication?
  riderApprovals   RiderServiceApproval[]
  bookingEvents    BookingEvent[]
  supportMessages  SupportMessage[]
  adminAudits      AdminAudit[]

  bookingsAsCustomer     Booking[]                  @relation("CustomerBookings")
  bookingsAsRider        Booking[]                  @relation("RiderBookings")
  trackingUpdates        TrackingUpdate[]
  deliveryProofs         DeliveryProof[]
  reviewsAsCustomer      CustomerReview[]           @relation("ReviewCustomer")
  reviewsAsRider         CustomerReview[]           @relation("ReviewRider")
  supportTickets         SupportTicket[]
  assignedSupportTickets SupportTicket[]            @relation("SupportAssignee")
  checkoutDrafts         CheckoutDraft[]
  notifications          CustomerNotification[]
  pushSubscriptions      CustomerPushSubscription[]
}

// Owner authentication is deliberately separate from staff password identities.
model OwnerIdentity {
  id                String            @id @default(cuid())
  actorId           String            @unique
  name              String
  email             String            @unique
  active            Boolean           @default(true)
  passwordHash      String?
  passwordChangedAt DateTime?
  createdAt         DateTime          @default(now())
  actor             User              @relation(fields: [actorId], references: [id])
  credentials       OwnerCredential[]
  sessions          OwnerSession[]
  invitations       OwnerInvitation[]
}

model OwnerCredential {
  id         String        @id
  ownerId    String
  label      String
  publicKey  Bytes
  counter    BigInt        @default(0)
  transports String[]      @default([])
  createdAt  DateTime      @default(now())
  owner      OwnerIdentity @relation(fields: [ownerId], references: [id])
}

model OwnerSession {
  id         String        @id
  ownerId    String
  createdAt  DateTime      @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime      @default(now())
  verifiedAt DateTime      @default(now())
  revokedAt  DateTime?
  owner      OwnerIdentity @relation(fields: [ownerId], references: [id])

  @@index([ownerId, expiresAt])
}

model OwnerInvitation {
  id        String        @id
  ownerId   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  owner     OwnerIdentity @relation(fields: [ownerId], references: [id])
}

model OwnerChallenge {
  id           String   @id
  challenge    String
  purpose      String
  ownerId      String?
  invitationId String?
  sessionId    String?
  expiresAt    DateTime

  @@index([expiresAt])
}

model OwnerAudit {
  id        String   @id @default(cuid())
  actorId   String
  actorName String
  action    String
  entityId  String
  details   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model StaffSession {
  id        String    @id
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId, expiresAt])
}

model PlatformConfig {
  id        String   @id @default("platform")
  version   Int      @default(1)
  settings  Json
  updatedAt DateTime @updatedAt
}

model WorkflowCase {
  id             String         @id @default(cuid())
  kind           String
  title          String
  summary        String
  priority       String         @default("NORMAL")
  status         String         @default("OPEN")
  bookingId      String?
  ticketId       String?
  subjectUserId  String?
  assignedToId   String?
  createdById    String
  createdByName  String
  recommendation String?
  decision       String?
  decidedById    String?
  decidedAt      DateTime?
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  notes          WorkflowNote[]

  @@index([kind, assignedToId, status])
  @@index([bookingId])
}

model WorkflowNote {
  id         String       @id @default(cuid())
  caseId     String
  authorId   String
  authorName String
  body       String
  createdAt  DateTime     @default(now())
  case       WorkflowCase @relation(fields: [caseId], references: [id])

  @@index([caseId, createdAt])
}

model SupportInternalNote {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])
}

model StaffResource {
  id          String   @id @default(cuid())
  kind        String
  title       String
  body        String
  version     Int      @default(1)
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, updatedAt])
}

model Booking {
  id                  String        @id @default(cuid())
  refCode             String        @unique
  // Rider-only tracking ticket — R0001 (ride) / D0001 (delivery), sequential
  // per type. Carries the order snapshot that gets copy-pasted into the
  // native tracking app (see src/lib/ticket.ts). Never exposed to customers.
  ticketId            String?       @unique
  // "DELIVERY" | "RIDE" — customers pick a mode after logging in.
  type                BookingType   @default(DELIVERY)
  customerId          String
  riderId             String?
  pickupLabel         String
  pickupLat           Float
  pickupLng           Float
  dropoffLabel        String
  dropoffLat          Float
  dropoffLng          Float
  vehicleClass        VehicleClass
  // DELIVERY: cargo weight in kg. RIDE: passenger count (default 1).
  cargoWeightKg       Float         @default(1.0)
  passengers          Int           @default(1)
  cargoNotes          String?
  scheduledAt         DateTime?
  distanceKm          Float
  baseFare            Decimal       @db.Decimal(12, 2)
  surgeMultiplier     Decimal       @default(1.0) @db.Decimal(5, 3)
  totalFare           Decimal       @db.Decimal(12, 2)
  currency            String        @default("PHP")
  status              BookingStatus @default(PENDING)
  matchedAt           DateTime?
  pickedUpAt          DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  paymentMethod       PaymentMethod @default(CASH)
  paymentStatus       PaymentStatus @default(UNPAID)
  customerPaidAmount  Decimal?      @db.Decimal(12, 2)
  riderReceivedAmount Decimal?      @db.Decimal(12, 2)
  customerPaidAt      DateTime?
  riderReceivedAt     DateTime?
  paidAt              DateTime?
  paymentReference    String?
  // Demo accounting only: never a provider balance or a real transfer.
  demoCommissionBps   Int?
  demoCommission      Decimal?      @db.Decimal(12, 2)
  demoRiderEarnings   Decimal?      @db.Decimal(12, 2)
  demoPayoutAt        DateTime?
  demoPayoutReference String?
  assignmentExpiresAt DateTime?
  excludedRiderIds    String[]      @default([])
  etaMinutes          Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customer          User                   @relation("CustomerBookings", fields: [customerId], references: [id])
  rider             User?                  @relation("RiderBookings", fields: [riderId], references: [id])
  trackingUpdates   TrackingUpdate[]
  deliveryProofs    DeliveryProof[]
  events            BookingEvent[]
  deliveryChallenge DeliveryChallenge?
  liveLocation      BookingLocation?
  review            CustomerReview?
  supportTickets    SupportTicket[]
  paymentEvents     PaymentEvent[]
  demoCheckouts     DemoCheckout[]
  checkoutDraft     CheckoutDraft?
  notifications     CustomerNotification[]

  @@index([customerId, createdAt, id])
  @@index([riderId, status, createdAt])
  @@index([status, vehicleClass, createdAt])
  @@index([type, createdAt])
  @@index([status, assignmentExpiresAt])
}

model DemoCheckout {
  id         String             @id @default(cuid())
  bookingId  String?
  draftId    String?
  status     DemoCheckoutStatus @default(PENDING)
  createdAt  DateTime           @default(now())
  resolvedAt DateTime?
  booking    Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  draft      CheckoutDraft?     @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([draftId, createdAt])
}

// A quote and validated order snapshot, never an active booking or rider job.
model CheckoutDraft {
  id          String         @id
  customerId  String
  requestHash String
  bookingData Json
  expiresAt   DateTime
  createdAt   DateTime       @default(now())
  bookingId   String?        @unique
  customer    User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking     Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  checkouts   DemoCheckout[]

  @@index([customerId, createdAt])
}

model PaymentEvent {
  id         String        @id @default(cuid())
  bookingId  String
  actorId    String
  actorName  String
  actorRole  UserRole
  action     String
  amount     Decimal?      @db.Decimal(12, 2)
  fromStatus PaymentStatus
  toStatus   PaymentStatus
  reason     String?
  reference  String?
  createdAt  DateTime      @default(now())
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

// Atomic per-type sequence backing Booking.ticketId — one row per
// TicketType ("RIDE" | "DELIVERY"). Incremented with a raw upsert
// (see generateTicketId in src/lib/ticket.ts) so two simultaneous
// bookings never get the same number.
model TicketCounter {
  type  String @id
  value Int    @default(0)
}

// Shared atomic API limits across serverless instances. Keys are HMAC digests;
// expired buckets are removed by the existing daily maintenance job.
model RateLimitBucket {
  key       String   @id
  hits      Int
  expiresAt DateTime

  @@index([expiresAt])
}

model TrackingUpdate {
  id         String         @id @default(cuid())
  bookingId  String
  riderId    String
  lat        Float
  lng        Float
  source     TrackingSource @default(LEGACY) // NATIVE only for ticket-authenticated phone updates
  speedKph   Float?
  heading    Float?
  etaMinutes Int?
  createdAt  DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rider   User    @relation(fields: [riderId], references: [id])

  @@index([bookingId, createdAt])
  @@index([createdAt])
}

model DeliveryProof {
  id            String    @id @default(cuid())
  bookingId     String
  riderId       String
  proofType     ProofType
  signatureSvg  String?
  verifiedAt    DateTime?
  photoUrl      String?
  recipientName String?
  notes         String?
  createdAt     DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rider   User    @relation(fields: [riderId], references: [id])

  @@index([bookingId])
}

model CustomerReview {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  customerId String
  riderId    String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customer   User     @relation("ReviewCustomer", fields: [customerId], references: [id])
  rider      User     @relation("ReviewRider", fields: [riderId], references: [id])

  @@index([riderId])
}

model SupportTicket {
  id                    String                 @id @default(cuid())
  customerId            String
  bookingId             String?
  category              SupportCategory
  message               String
  status                SupportStatus          @default(OPEN)
  priority              SupportPriority        @default(NORMAL)
  assignedAdminId       String?
  customerReadAt        DateTime?
  lastCustomerMessageAt DateTime               @default(now())
  lastAdminReplyAt      DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  notifications         CustomerNotification[]
  customer              User                   @relation(fields: [customerId], references: [id])
  booking               Booking?               @relation(fields: [bookingId], references: [id])
  assignedAdmin         User?                  @relation("SupportAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages              SupportMessage[]

  @@index([customerId, createdAt])
  @@index([status])
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  authorId   String?
  authorName String
  authorRole UserRole      @default(ADMIN)
  body       String
  createdAt  DateTime      @default(now())
  author     User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model AdminAudit {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String
  action     String
  entityType String
  entityId   String
  details    Json
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}

// Identity is independent of the login provider's ID.
model AuthIdentity {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  passwordHash   String?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

// Short-lived challenges; subjectId is either a Firebase UID or a Neon user ID.
// No plaintext codes or passwords are stored here.
model AuthEmailCode {
  id        String       @id
  purpose   String
  email     String
  subjectId String
  provider  AuthProvider
  codeHash  String
  attempts  Int          @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@unique([email, purpose])
  @@index([expiresAt])
}

model RiderProfile {
  userId          String       @id
  vehicleClass    VehicleClass
  vehiclePlate    String?
  rating          Float        @default(5)
  totalDeliveries Int          @default(0)
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RiderApplication {
  id                      String                     @id @default(cuid())
  userId                  String                     @unique
  isDemo                  Boolean                    @default(false)
  status                  String                     @default("DRAFT")
  vehicleClass            VehicleClass
  services                BookingType[]
  fields                  Json                       @default("{}")
  fieldReviews            Json                       @default("{}")
  emailVerifiedAt         DateTime?
  verifiedEmail           String?
  assignedToId            String?
  recommendedById         String?
  recommendedAt           DateTime?
  orientationAt           DateTime?
  orientationVenue        String?
  orientationInstructions String?
  attendedAt              DateTime?
  assessmentPassedAt      DateTime?
  assessmentNotes         String?
  assessedById            String?
  version                 Int                        @default(1)
  submittedAt             DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  user                    User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents               RiderApplicationDocument[]
  events                  RiderApplicationEvent[]
  emails                  RiderApplicationEmail[]

  @@index([status, updatedAt])
}

model RiderApplicationDocument {
  id            String           @id @default(cuid())
  applicationId String
  kind          String
  version       Int
  current       Boolean          @default(true)
  pathname      String
  mimeType      String
  status        String           @default("PENDING")
  reason        String?
  issuedAt      DateTime?
  expiresAt     DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())
  application   RiderApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, kind, version])
  @@index([applicationId, current])
}

model RiderApplicationEvent {
  id            String           @id @default(cuid())
  applicationId String
  actorId       String
  actorName     String
  action        String
  details       Json
  createdAt     DateTime         @default(now())
  application   RiderApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model RiderServiceApproval {
  id            String       @id @default(cuid())
  userId        String
  vehicleClass  VehicleClass
  service       BookingType
  source        String
  operatingZone Json?
  approvedById  String?
  approvedAt    DateTime     @default(now())
  validUntil    DateTime?
  revokedAt     DateTime?
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, vehicleClass, service])
}

model RiderApplicationEmail {
  id            String           @id @default(cuid())
  sourceId      String           @unique
  applicationId String
  kind          String
  recipient     String
  payload       Json
  status        String           @default("PENDING")
  attempts      Int              @default(0)
  startedAt     DateTime?
  sentAt        DateTime?
  failureCode   String?
  createdAt     DateTime         @default(now())
  application   RiderApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model RiderPresence {
  userId     String    @id
  isOnline   Boolean   @default(false)
  lat        Float?
  lng        Float?
  locationAt DateTime?
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isOnline, locationAt])
}

model BookingEvent {
  id         String             @id @default(cuid())
  bookingId  String
  actorId    String?
  actorName  String
  actorRole  UserRole
  action     BookingEventAction
  fromStatus BookingStatus?
  toStatus   BookingStatus
  riderId    String?
  reason     String?
  createdAt  DateTime           @default(now())
  booking    Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor      User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
}

model DeliveryChallenge {
  bookingId      String    @id
  codeHash       String
  codeCiphertext String
  expiresAt      DateTime
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// One latest native location per booking; history is sampled separately.
model BookingLocation {
  bookingId String   @id
  riderId   String
  lat       Float
  lng       Float
  speedKph  Float?
  heading   Float?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// Shared, server-only VAPID identity. Only the public key is exposed to devices.
// Keeping one persistent identity lets the three deployments send to the same
// customer subscriptions without putting a private key in a browser or Git.
model WebPushIdentity {
  id         String   @id
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())
}

model CustomerPushSubscription {
  id         String   @id @default(cuid())
  customerId String
  deviceId   String   @unique
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerNotification {
  id                String                       @id @default(cuid())
  sourceId          String                       @unique
  customerId        String
  category          CustomerNotificationCategory
  bookingId         String?
  ticketId          String?
  status            BookingStatus?
  title             String
  body              String
  url               String
  createdAt         DateTime                     @default(now())
  readAt            DateTime?
  pushDeliveredAt   DateTime?
  pushLeaseUntil    DateTime?
  pushNextAttemptAt DateTime                     @default(now())
  pushAttempts      Int                          @default(0)
  customer          User                         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking           Booking?                     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticket            SupportTicket?               @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([customerId, category, readAt])
  @@index([customerId, createdAt, id])
  @@index([pushDeliveredAt, pushNextAttemptAt])
}
