// Canonical Fetch schema: maintained in fetch-customer/prisma.
// Run node scripts/sync-shared.cjs after changes; only this app deploys migrations.
// All apps share the same Neon PostgreSQL database.

enum UserRole {
  CUSTOMER
  RIDER
  ADMIN
}

enum AuthProvider {
  FIREBASE
  PASSWORD
}

enum BookingType {
  DELIVERY
  RIDE
}

enum BookingStatus {
  PENDING
  MATCHED
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum VehicleClass {
  MOTORCYCLE
  TRICYCLE
  SEDAN
  CLOSED_VAN
  FLATBED
  REFRIGERATED
}

enum TrackingSource {
  LEGACY
  NATIVE
}

enum ProofType {
  SIGNATURE
  OTP
  PHOTO
}

enum SupportCategory {
  BOOKING
  FARE
  RIDER
  LOST_ITEM
  OTHER
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum BookingEventAction {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  CANCELLED
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  phone     String?
  role      UserRole  @default(CUSTOMER)
  isBanned  Boolean   @default(false)
  banReason String?
  bannedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  authIdentities  AuthIdentity[]
  riderProfile    RiderProfile?
  riderPresence   RiderPresence?
  bookingEvents   BookingEvent[]
  supportMessages SupportMessage[]
  adminAudits     AdminAudit[]

  bookingsAsCustomer     Booking[]        @relation("CustomerBookings")
  bookingsAsRider        Booking[]        @relation("RiderBookings")
  trackingUpdates        TrackingUpdate[]
  deliveryProofs         DeliveryProof[]
  reviewsAsCustomer      CustomerReview[] @relation("ReviewCustomer")
  reviewsAsRider         CustomerReview[] @relation("ReviewRider")
  supportTickets         SupportTicket[]
  assignedSupportTickets SupportTicket[]  @relation("SupportAssignee")
}

model Booking {
  id              String        @id @default(cuid())
  refCode         String        @unique
  // Rider-only tracking ticket — R0001 (ride) / D0001 (delivery), sequential
  // per type. Carries the order snapshot that gets copy-pasted into the
  // native tracking app (see src/lib/ticket.ts). Never exposed to customers.
  ticketId        String?       @unique
  // "DELIVERY" | "RIDE" — customers pick a mode after logging in.
  type            BookingType   @default(DELIVERY)
  customerId      String
  riderId         String?
  pickupLabel     String
  pickupLat       Float
  pickupLng       Float
  dropoffLabel    String
  dropoffLat      Float
  dropoffLng      Float
  vehicleClass    VehicleClass
  // DELIVERY: cargo weight in kg. RIDE: passenger count (default 1).
  cargoWeightKg   Float         @default(1.0)
  passengers      Int           @default(1)
  cargoNotes      String?
  scheduledAt     DateTime?
  distanceKm      Float
  baseFare        Decimal       @db.Decimal(12, 2)
  surgeMultiplier Decimal       @default(1.0) @db.Decimal(5, 3)
  totalFare       Decimal       @db.Decimal(12, 2)
  currency        String        @default("PHP")
  status          BookingStatus @default(PENDING)
  matchedAt       DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  etaMinutes      Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer          User               @relation("CustomerBookings", fields: [customerId], references: [id])
  rider             User?              @relation("RiderBookings", fields: [riderId], references: [id])
  trackingUpdates   TrackingUpdate[]
  deliveryProofs    DeliveryProof[]
  events            BookingEvent[]
  deliveryChallenge DeliveryChallenge?
  liveLocation      BookingLocation?
  review            CustomerReview?
  supportTickets    SupportTicket[]

  @@index([customerId, createdAt, id])
  @@index([riderId, status, createdAt])
  @@index([status, vehicleClass, createdAt])
  @@index([type, createdAt])
}

// Atomic per-type sequence backing Booking.ticketId — one row per
// TicketType ("RIDE" | "DELIVERY"). Incremented with a raw upsert
// (see generateTicketId in src/lib/ticket.ts) so two simultaneous
// bookings never get the same number.
model TicketCounter {
  type  String @id
  value Int    @default(0)
}

model TrackingUpdate {
  id         String         @id @default(cuid())
  bookingId  String
  riderId    String
  lat        Float
  lng        Float
  source     TrackingSource @default(LEGACY) // NATIVE only for ticket-authenticated phone updates
  speedKph   Float?
  heading    Float?
  etaMinutes Int?
  createdAt  DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rider   User    @relation(fields: [riderId], references: [id])

  @@index([bookingId, createdAt])
  @@index([createdAt])
}

model DeliveryProof {
  id            String    @id @default(cuid())
  bookingId     String
  riderId       String
  proofType     ProofType
  signatureSvg  String?
  verifiedAt    DateTime?
  photoUrl      String?
  recipientName String?
  notes         String?
  createdAt     DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rider   User    @relation(fields: [riderId], references: [id])

  @@index([bookingId])
}

model CustomerReview {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  customerId String
  riderId    String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customer   User     @relation("ReviewCustomer", fields: [customerId], references: [id])
  rider      User     @relation("ReviewRider", fields: [riderId], references: [id])

  @@index([riderId])
}

model SupportTicket {
  id              String           @id @default(cuid())
  customerId      String
  bookingId       String?
  category        SupportCategory
  message         String
  status          SupportStatus    @default(OPEN)
  priority        SupportPriority  @default(NORMAL)
  assignedAdminId String?
  customerReadAt  DateTime?
  lastCustomerMessageAt DateTime @default(now())
  lastAdminReplyAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  customer        User             @relation(fields: [customerId], references: [id])
  booking         Booking?         @relation(fields: [bookingId], references: [id])
  assignedAdmin   User?            @relation("SupportAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages        SupportMessage[]

  @@index([customerId, createdAt])
  @@index([status])
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  authorId   String?
  authorName String
  authorRole UserRole      @default(ADMIN)
  body       String
  createdAt  DateTime      @default(now())
  author     User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model AdminAudit {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String
  action     String
  entityType String
  entityId   String
  details    Json
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}

// Identity is independent of the login provider's ID.
model AuthIdentity {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  passwordHash   String?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

model RiderProfile {
  userId          String       @id
  vehicleClass    VehicleClass
  vehiclePlate    String?
  rating          Float        @default(5)
  totalDeliveries Int          @default(0)
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RiderPresence {
  userId     String    @id
  isOnline   Boolean   @default(false)
  lat        Float?
  lng        Float?
  locationAt DateTime?
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isOnline, locationAt])
}

model BookingEvent {
  id         String             @id @default(cuid())
  bookingId  String
  actorId    String?
  actorName  String
  actorRole  UserRole
  action     BookingEventAction
  fromStatus BookingStatus?
  toStatus   BookingStatus
  riderId    String?
  reason     String?
  createdAt  DateTime           @default(now())
  booking    Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor      User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
}

model DeliveryChallenge {
  bookingId      String    @id
  codeHash       String
  codeCiphertext String
  expiresAt      DateTime
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// One latest native location per booking; history is sampled separately.
model BookingLocation {
  bookingId String   @id
  riderId   String
  lat       Float
  lng       Float
  speedKph  Float?
  heading   Float?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}
