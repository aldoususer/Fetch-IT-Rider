// Fetch-It shared database schema (PostgreSQL — Railway).
//
// This is THE single source of truth for all three Fetch-It apps:
//   • customer app  (fetch-customer)
//   • rider app     (fetch-rider)
//   • admin app     (fetch-it-admin)
// All three point DATABASE_URL at the same Railway Postgres instance, so a
// booking created by a customer appears instantly in the rider job feed and
// in the admin dashboard.
//
// Booking.type distinguishes the two products:
//   • DELIVERY — cargo transport (vehicle classes: MOTORCYCLE … REFRIGERATED)
//   • RIDE     — passenger transport (vehicle classes: MOTORCYCLE, TRICYCLE, SEDAN)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  phone           String?
  passwordHash    String
  role            String    @default("CUSTOMER")
  vehicleClass    String?
  vehiclePlate    String?
  rating          Float     @default(5.0)
  totalDeliveries Int       @default(0)
  isOnline        Boolean   @default(false)
  lat             Float?
  lng             Float?
  locationAt      DateTime?
  isBanned        Boolean   @default(false)
  banReason       String?
  bannedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bookingsAsCustomer Booking[]       @relation("CustomerBookings")
  bookingsAsRider    Booking[]       @relation("RiderBookings")
  trackingUpdates    TrackingUpdate[]
  deliveryProofs     DeliveryProof[]
}

model Booking {
  id              String    @id @default(cuid())
  refCode         String    @unique
  // Rider-only tracking ticket — R0001 (ride) / D0001 (delivery), sequential
  // per type. Carries the order snapshot that gets copy-pasted into the
  // native tracking app (see src/lib/ticket.ts). Never exposed to customers.
  ticketId        String?   @unique
  // "DELIVERY" | "RIDE" — customers pick a mode after logging in.
  type            String    @default("DELIVERY")
  customerId      String
  riderId         String?
  pickupLabel     String
  pickupLat       Float
  pickupLng       Float
  dropoffLabel    String
  dropoffLat      Float
  dropoffLng      Float
  vehicleClass    String
  // DELIVERY: cargo weight in kg. RIDE: passenger count (default 1).
  cargoWeightKg   Float     @default(1.0)
  passengers      Int       @default(1)
  cargoNotes      String?
  scheduledAt     DateTime?
  distanceKm      Float
  baseFare        Float
  surgeMultiplier Float     @default(1.0)
  totalFare       Float
  currency        String    @default("PHP")
  status          String    @default("PENDING")
  matchedAt       DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  etaMinutes      Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer        User      @relation("CustomerBookings", fields: [customerId], references: [id])
  rider           User?     @relation("RiderBookings", fields: [riderId], references: [id])
  trackingUpdates TrackingUpdate[]
  deliveryProofs  DeliveryProof[]

  @@index([status])
  @@index([type])
  @@index([riderId])
  @@index([customerId])
}

// Atomic per-type sequence backing Booking.ticketId — one row per
// TicketType ("RIDE" | "DELIVERY"). Incremented with a raw upsert
// (see generateTicketId in src/lib/ticket.ts) so two simultaneous
// bookings never get the same number.
model TicketCounter {
  type  String @id
  value Int    @default(0)
}

model TrackingUpdate {
  id         String   @id @default(cuid())
  bookingId  String
  riderId    String
  lat        Float
  lng        Float
  speedKph   Float?
  heading    Float?
  etaMinutes Int?
  createdAt  DateTime @default(now())

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rider      User     @relation(fields: [riderId], references: [id])

  @@index([bookingId])
  @@index([createdAt])
}

model DeliveryProof {
  id            String   @id @default(cuid())
  bookingId     String
  riderId       String
  proofType     String
  signatureSvg  String?
  otpCode       String?
  otpVerified   Boolean  @default(false)
  photoUrl      String?
  recipientName String?
  notes         String?
  createdAt     DateTime @default(now())

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rider         User     @relation(fields: [riderId], references: [id])

  @@index([bookingId])
}
