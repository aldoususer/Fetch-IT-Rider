# Fetch-It Rider app — environment variables
# Copy this file to `.env` for local development, and add the same variables
# in Vercel → Project → Settings → Environment Variables for deployment.

# Shared Railway PostgreSQL instance (all three Fetch-It apps use this DB).
# Use the PUBLIC connection string from Railway, not the internal one.
DATABASE_URL=postgresql://user:password@host:port/railway

# Google Maps / Places key used for address autocomplete and route maps.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_ENABLED=0
# Shared Rider application guard; can be lowered, hard-capped at 100 attempts.
# Google Cloud quotas must separately protect the total Customer + Rider bill.
GOOGLE_MAPS_DAILY_LIMIT=100

# Required in production: generate 32 random bytes (64 hex characters).
# Missing, short or sample secrets prevent rider sign-in.
SESSION_SECRET=

# Same random value in customer and rider deployments; do not rotate with active delivery codes.
DELIVERY_CODE_SECRET=

# Authenticates the daily GPS retention job (Vercel cron).
CRON_SECRET=

# ePOD photos: use the SAME PRIVATE Vercel Blob store in all Fetch apps.
# Connected Vercel projects use OIDC with this store ID.
BLOB_STORE_ID=
# Local development or cross-account fallback; server-only, never NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=

# Free Standard key; server-only. Do not use NEXT_PUBLIC_ for this key.
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_ENABLED=0
# Shared rolling limits, hard-capped at 1800/day and 30/minute.
OPENROUTESERVICE_DAILY_LIMIT=1800
OPENROUTESERVICE_MINUTE_LIMIT=30
